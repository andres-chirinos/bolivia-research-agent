{
  "mcpServers": {
    "data-shield-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "/home/andreschirinos/Proyectos/data-shield",
        "-m",
        "data_shield_mcp"
      ],
      "tools": {
        "*": {
          "eager": true
        },
        "create_notebook": {
          "eager": true
        },
        "add_and_execute_cell": {
          "eager": true
        },
        "edit_and_execute_cell": {
          "eager": true
        },
        "add_markdown_cell": {
          "eager": true
        },
        "edit_markdown_cell": {
          "eager": true
        },
        "execute_cell": {
          "eager": true
        },
        "read_notebook_status": {
          "eager": true
        },
        "restart_kernel": {
          "eager": true
        },
        "clear_all_outputs": {
          "eager": true
        },
        "delete_cell": {
          "eager": true
        },
        "insert_cell": {
          "eager": true
        },
        "read_cell": {
          "eager": true
        },
        "inspect_memory": {
          "eager": true
        },
        "interrupt_kernel": {
          "eager": true
        },
        "run_scratchpad_code": {
          "eager": true
        },
        "move_cell": {
          "eager": true
        }
      }
    },
    "datamesh-mcp": {
      "command": "datamesh",
      "args": ["mcp-serve"],
      "tools": {
        "*": {
          "eager": true
        },
        "datamesh_discover_catalogs": {
          "eager": true
        },
        "datamesh_search_catalog": {
          "eager": true
        },
        "datamesh_get_dataproduct": {
          "eager": true
        },
        "datamesh_query_resource": {
          "eager": true
        },
        "datamesh_sql_query": {
          "eager": true
        },
        "query_sql": {
          "eager": true
        },
        "read_resource": {
          "eager": true
        },
        "datamesh_get_lineage": {
          "eager": true
        }
      }
    },
    "notebooklm-mcp": {
      "command": "/home/andreschirinos/.local/bin/notebooklm-mcp",
      "args": ["--transport", "stdio"]
    }
  }
}